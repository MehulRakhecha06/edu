# ==============================================================
# Aimmers Nepal — AI service (Python) environment variables
# Copy to .env and adjust. Everything is optional; defaults are
# safe for local development (mock backend).
# ==============================================================

# ---- Backend ----------------------------------------------------
# mock | ollama | huggingface | transformers
# Leave empty to auto-detect: OLLAMA_URL -> ollama, HF_TOKEN -> huggingface,
# otherwise mock.
AI_BACKEND=

# ---- Shared secret (optional — only when exposing the service) ----
# Leave EMPTY while everything runs on this machine (localhost): the web app
# and the service then need no key at all. Even if you DO set one, the web
# app picks it up automatically from this file (same repo) — a mismatch 401
# can only happen with a REMOTE service, where you must set AI_API_KEY in the
# web app's .env.local to the same value.
SERVICE_API_KEY=

# ---- CORS -------------------------------------------------------
# Comma-separated origins allowed to call this service ("*" = all).
WEB_ORIGINS=*

# ---- Per-request LLM timeout (seconds) --------------------------
AI_TIMEOUT_SECONDS=60

# ---- Ollama backend ----------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
# VISION model for photos/scans of question papers (needs ~8GB RAM):
#   ollama pull llama3.2-vision:11b
OLLAMA_VISION_MODEL=llama3.2-vision:11b

# ---- Hugging Face backend ----------------------------------------
# Free token from https://huggingface.co/settings/tokens
HF_TOKEN=
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# Vision-language model for photos/scans
HF_VISION_MODEL=Qwen/Qwen2-VL-7B-Instruct

# ---- transformers backend (needs the optional extras) ------------
TRANSFORMERS_MODEL=HuggingFaceTB/SmolLM2-1.7B-Instruct

# ---- Parser ------------------------------------------------------
# Max characters of question-bank text per parse call
PARSER_MAX_CHARS=9000
# Max PDF pages rendered per scanned-PDF request (each page = 1 image)
VISION_MAX_PAGES=8
