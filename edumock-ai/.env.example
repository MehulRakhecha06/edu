# =========================================
# SUPABASE (Database)
# =========================================
# Find in: Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://ubuwjvtrdcldeqziytjq.supabase.co

# Find in: Project Settings → API → Publishable key
NEXT_PUBLIC_SUPABASE_ANON_KEY=authorized_key_here

# Find in: Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=secret_key_here

# =========================================
# NEXT AUTH (Authentication)
# =========================================
# When deploying to Vercel, change this to your Vercel URL
NEXTAUTH_URL=http://localhost:3000

# Generate a random string: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=your_random_secret_here

# =========================================
# HUGGING FACE (AI)
# =========================================
# Find in: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_api_key_here