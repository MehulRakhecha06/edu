# ==============================================================
# EduMock AI — environment variables
# Copy this file to ".env.local" and fill in the values.
# NEVER commit .env.local to git.
# ==============================================================

# ---- Auth ------------------------------------------------------
# Generate a secret with:  openssl rand -base64 32
# (NEXTAUTH_SECRET from older NextAuth setups is accepted as an alias)
# (or PowerShell: [Convert]::ToBase64String((1..32|%{Get-Random -Maximum 256})))
AUTH_SECRET=change-me-generate-a-long-random-string

# ---- Supabase (database) --------------------------------------
# From Supabase Dashboard -> Project Settings -> API
# If you leave these empty the app runs in DEMO MODE
# (in-memory database, seeded demo accounts) — great for
# showing the client a preview with zero setup.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# ---- AI provider ----------------------------------------------
# NOTE: The admin can switch providers at RUNTIME from the dashboard
# (Admin -> AI Settings, stored in the database). These environment
# variables are the bootstrap defaults and the fallback — the app works
# even if nobody ever opens the settings page.
#
# RECOMMENDED: run our Python AI service first (see ai-service/README.md):
#   cd ai-service && pip install -r requirements.txt
#   python3 -m uvicorn app.main:app --port 8000
# then use the URL below. The web app auto-detects the service and routes
# question extraction, explanations and the assistant to it.
#AI_BASE_URL=http://localhost:8000/v1
#AI_MODEL=edumock-service
#
# Other OpenAI-compatible local servers also work directly:
#             Ollama:     http://localhost:11434/v1   (ollama serve)
#             LM Studio:  http://localhost:1234/v1
#             llama.cpp:  http://localhost:8080/v1    (llama-server)
#             vLLM:       http://localhost:8000/v1
# Example (Ollama with a light 1B model):
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=llama3.2:1b
# Only needed if your local server requires a key (usually not)
#AI_API_KEY=
# Per-request timeout in ms — local models on CPU can be slow (default 60000)
#AI_TIMEOUT_MS=60000

# Option B — Hugging Face Inference API (free token, used when
#            AI_BASE_URL is empty). Best for Vercel deployments.
# Free plan: ~$0.10/month of inference credits, rate-limited — fine for
# demos; for a whole class use a local model (free, unlimited) or PRO.
# Free token from https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=
# Optional model override — must be a model Hugging Face actually SERVES via
# Inference Providers (huggingface.co/models, filter "Inference Providers").
# The catalog rotates: if you get HTTP 404, the model was retired — pick another.
#HF_MODEL=Qwen/Qwen2.5-7B-Instruct

# If NO provider is configured, the app still works: explanations and the
# assistant use built-in answers, and PDF parsing uses the deterministic
# parser (needs an answer key like "Answer: B" in the document).

# ---- Seeding (npm run seed) ------------------------------------
# The first admin account created in Supabase by `npm run seed`.
SEED_ADMIN_EMAIL=mehulrakhecha@gmail.com
SEED_ADMIN_NAME=Mehul Rakhecha
# ⚠️ Change this before going live — it's shown here so the demo
# credentials match the demo-mode accounts (Admin@123).
SEED_ADMIN_PASSWORD=Admin@123
